# =============================================================================
# Example environment file — PLACEHOLDERS ONLY.
#
# Copy to `.env` locally and fill in real values there. `.env` is git-ignored and
# must never be committed. This example intentionally contains no working API key,
# no database password and no personal data.
#
# The application does NOT read secrets from configuration files: it reads the
# *name* of a variable (see `config/models.example.yaml`, `storage.database_dsn_reference`)
# and resolves the value from the process environment at runtime.
# =============================================================================

# --- Optional operational overrides (non-secret) ----------------------------
# RESEARCH_PLATFORM_ENVIRONMENT=local
# RESEARCH_PLATFORM_LOG_LEVEL=INFO
# RESEARCH_PLATFORM_ARTIFACT_ROOT=artifact://local/artifacts

# --- Database (storage group, Iteration 1) ---------------------------------
# The value must be a full DSN in the environment, never in a committed file.
RESEARCH_PLATFORM_DB_DSN=postgresql+psycopg://CHANGE_ME_USER:CHANGE_ME_PASSWORD@localhost:5432/CHANGE_ME_DB

# --- Model providers (provider is NOT selected yet — see ADR-005) ----------
# One variable per configured `api_key_env` entry in config/models.example.yaml.
# Leave empty until the project owner approves a provider.
RESEARCH_PLATFORM_EXTRACTION_API_KEY=
RESEARCH_PLATFORM_EMBEDDING_API_KEY=

# --- Observability ----------------------------------------------------------
# Never enable prompt/document content export without a privacy review.
RESEARCH_PLATFORM_TRACE_CONTENT=false
